From c5e322954492339a15abc31c9fac4d0729c8f8ed Mon Sep 17 00:00:00 2001
From: Arthur Liberman <arthur_liberman@hotmail.com>
Date: Mon, 6 Jan 2025 02:35:37 +0200
Subject: [PATCH 2/4] Linux: arm: fixup statx syscall number missing

---
 sysdeps/unix/sysv/linux/internal-stat.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sysdeps/unix/sysv/linux/internal-stat.h b/sysdeps/unix/sysv/linux/internal-stat.h
index 9334059765..59387693aa 100644
--- a/sysdeps/unix/sysv/linux/internal-stat.h
+++ b/sysdeps/unix/sysv/linux/internal-stat.h
@@ -21,7 +21,7 @@
 #include <kernel_stat.h>
 #include <kstat_cp.h>
 
-#if (__WORDSIZE == 32 \
+#if (__WORDSIZE == 32 && defined __NR_statx \
      && (!defined __SYSCALL_WORDSIZE || __SYSCALL_WORDSIZE == 32)) \
      || defined STAT_HAS_TIME32 \
      || (!defined __NR_newfstatat && !defined __NR_fstatat64)
