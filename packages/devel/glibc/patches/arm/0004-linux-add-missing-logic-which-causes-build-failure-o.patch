From 2a3571c6beda853928821fc6c8d8f63f7412a15c Mon Sep 17 00:00:00 2001
From: Arthur Liberman <arthur_liberman@hotmail.com>
Date: Mon, 6 Jan 2025 03:47:03 +0200
Subject: [PATCH 4/4] linux: add missing logic which causes build failure on
 arm

---
 sysdeps/unix/sysv/linux/fstat64.c | 30 +++++++++++++++++++++++++++---
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/sysdeps/unix/sysv/linux/fstat64.c b/sysdeps/unix/sysv/linux/fstat64.c
index cc9f695df9..7fd35860ef 100644
--- a/sysdeps/unix/sysv/linux/fstat64.c
+++ b/sysdeps/unix/sysv/linux/fstat64.c
@@ -51,17 +51,41 @@ __fstat64_time64 (int fd, struct __stat64_t64 *buf)
 #   endif /* STAT64_IS_KERNEL_STAT64 */
 #  endif
 # else /* XSTAT_IS_XSTAT64 */
+#  ifdef __NR_fstat64
+  /* All kABIs with non-LFS support and with old 32-bit time_t support
+     e.g. arm, csky, i386, hppa, m68k, microblaze, nios2, sh, powerpc32,
+     and sparc32.  */
+  struct stat64 st64;
+  int r = INLINE_SYSCALL_CALL (fstat64, fd, &st64);
+  if (r == 0)
+    {
+      /* Clear both pad and reserved fields.  */
+      memset (buf, 0, sizeof (*buf));
+
+      buf->st_dev = st64.st_dev,
+      buf->st_ino = st64.st_ino;
+      buf->st_mode = st64.st_mode;
+      buf->st_nlink = st64.st_nlink;
+      buf->st_uid = st64.st_uid;
+      buf->st_gid = st64.st_gid;
+      buf->st_rdev = st64.st_rdev;
+      buf->st_size = st64.st_size;
+      buf->st_blksize = st64.st_blksize;
+      buf->st_blocks  = st64.st_blocks;
+      buf->st_atim = valid_timespec_to_timespec64 (st64.st_atim);
+      buf->st_mtim = valid_timespec_to_timespec64 (st64.st_mtim);
+      buf->st_ctim = valid_timespec_to_timespec64 (st64.st_ctim);
+    }
+#  else
   /* 64-bit kabi outlier, e.g. mips64 and mips64-n32.  */
   struct kernel_stat kst;
   int r = INLINE_SYSCALL_CALL (fstat, fd, &kst);
   if (r == 0)
     __cp_kstat_stat64_t64 (&kst, buf);
+#  endif
   return r;
 # endif
 #else /* !FSTATAT_USE_STATX  */
-  /* All kABIs with non-LFS support and with old 32-bit time_t support
-     e.g. arm, csky, i386, hppa, m68k, microblaze, nios2, sh, powerpc32,
-     and sparc32.  */
   if (fd < 0)
     {
       __set_errno (EBADF);
-- 
