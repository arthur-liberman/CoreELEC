From 4691640e7deb4939a710fae1671d96c37e04fecb Mon Sep 17 00:00:00 2001
From: Arthur Liberman <arthur_liberman@hotmail.com>
Date: Sat, 15 Mar 2025 01:53:10 +0200
Subject: [PATCH 09/18] Revert "alsa: drop obsolete
 'aml_set_audio_passthrough'"

This reverts commit eb97f5c837e174b60b86c3d74405ce49400fa2f2.
---
 xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp | 1 +
 xbmc/utils/AMLUtils.cpp                     | 5 +++++
 xbmc/utils/AMLUtils.h                       | 1 +
 3 files changed, 7 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
index 3b0453bfce..e137df228e 100644
--- a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
@@ -807,6 +807,7 @@ bool CAESinkALSA::Initialize(AEAudioFormat &format, std::string &device)
       }
     }
 
+    aml_set_audio_passthrough(m_passthrough);
     aml_configure_simple_control(device, codec);
   }
 
diff --git a/xbmc/utils/AMLUtils.cpp b/xbmc/utils/AMLUtils.cpp
index 772dc741dc..76058fda95 100644
--- a/xbmc/utils/AMLUtils.cpp
+++ b/xbmc/utils/AMLUtils.cpp
@@ -281,6 +281,11 @@ bool aml_video_started()
   return (StringUtils::EqualsNoCase(videostarted.Get<std::string>().value(), "0x1"));
 }
 
+void aml_set_audio_passthrough(bool passthrough)
+{
+  CSysfsPath("/sys/class/audiodsp/digital_raw", (passthrough ? 2 : 0));
+}
+
 void aml_set_3d_video_mode(unsigned int mode, bool framepacking_support, int view_mode)
 {
   int fd;
diff --git a/xbmc/utils/AMLUtils.h b/xbmc/utils/AMLUtils.h
index 3c1bebe356..84e431ea45 100644
--- a/xbmc/utils/AMLUtils.h
+++ b/xbmc/utils/AMLUtils.h
@@ -81,6 +81,7 @@ bool aml_dolby_vision_enabled();
 bool aml_convert_to_dv_by_vs_engine(StreamHdrType hdrType);
 bool aml_video_started();
 bool aml_has_frac_rate_policy();
+void aml_set_audio_passthrough(bool passthrough);
 void aml_set_3d_video_mode(unsigned int mode, bool framepacking_support, int view_mode);
 bool aml_mode_to_resolution(const char *mode, RESOLUTION_INFO *res);
 bool aml_get_native_resolution(RESOLUTION_INFO *res);
