+void aml_handle_scale(const RESOLUTION_INFO &res)
+{
+  if (res.iScreenWidth > res.iWidth && res.iScreenHeight > res.iHeight)
+    aml_enable_freeScale(res);
+  else
+    aml_disable_freeScale();
+}
