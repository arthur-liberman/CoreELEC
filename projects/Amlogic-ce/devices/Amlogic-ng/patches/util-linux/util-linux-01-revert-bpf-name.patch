From 0d6aec0f0cdb60a7a4070bd6867e5262e327778c Mon Sep 17 00:00:00 2001
From: Arthur Liberman <arthur_liberman@hotmail.com>
Date: Fri, 21 Feb 2025 15:47:13 +0200
Subject: [PATCH 1/3] Revert "meson: check for BPF_OBJ_NAME_LEN and
 linux/bpf.h"

This reverts commit 1dc5dd58ccceebe1cc1a0596b764e8c84979f494.
---
 meson.build | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 39a5c6801..d8cdfdc6c 100644
--- a/meson.build
+++ b/meson.build
@@ -2783,8 +2783,7 @@ if opt and not is_disabler(exe)
   bashcompletions += ['lsblk']
 endif
 
-opt = not get_option('build-lsfd').require(lib_rt.found()).disabled() \
-      and cc.has_header_symbol('linux/bpf.h', 'BPF_OBJ_NAME_LEN')
+opt = not get_option('build-lsfd').require(lib_rt.found()).disabled()
 exe = executable(
   'lsfd',
   lsfd_sources,
-- 
